# Firebase console > Project settings > Your apps > Web app.
# Web configuration is public metadata, not an admin key. Security is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
# For iOS redirect sign-in, match the hosting origin (recommended: PROJECT_ID.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set only for local emulator development; never enable in a deployed build.
VITE_USE_EMULATORS=false
