{
  "name": "ororo-family",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "2.0.0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/access-config.mjs",
    "pretest:rules": "node scripts/access-config.mjs",
    "preemulators": "node scripts/access-config.mjs --development",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:auth": "firebase emulators:exec --project demo-ororo --only auth \"vitest run tests/auth.test.ts && playwright test --config playwright.auth.config.ts\"",
    "test:google-popup": "firebase emulators:exec --project demo-ororo --only auth \"playwright test --config playwright.google.config.ts\"",
    "test:rules": "firebase emulators:exec --project demo-ororo --only auth,firestore \"vitest run tests/rules.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-ororo --only auth \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-ororo --only auth,firestore",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "firebase-tools": "15.35.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
