rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [] /* ALLOWED_GOOGLE_EMAILS */;
    }
    function member(family) { return verified() && exists(/databases/$(database)/documents/families/$(family)/members/$(request.auth.uid)); }
    function owner(family) { return member(family) && get(/databases/$(database)/documents/families/$(family)).data.ownerId == request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }

    match /users/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId'])
        && request.resource.data.familyId is string
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(uid)).data.uid == uid;
    }

    match /families/{family} {
      allow get: if member(family);
      allow list, update, delete: if false;
      allow create: if verified() && !exists(userPath())
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'timeZone'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.timeZone == 'Asia/Tokyo'
        && getAfter(userPath()).data.familyId == family
        && getAfter(/databases/$(database)/documents/families/$(family)/members/$(request.auth.uid)).data.role == 'owner';

      match /members/{uid} {
        allow read: if member(family);
        allow update: if false;
        allow delete: if owner(family) && uid != request.auth.uid;
        allow create: if verified() && uid == request.auth.uid && !exists(userPath())
          && request.resource.data.uid == uid && request.resource.data.createdAt == request.time
          && getAfter(userPath()).data.familyId == family
          && (
            (!exists(/databases/$(database)/documents/families/$(family))
              && getAfter(/databases/$(database)/documents/families/$(family)).data.ownerId == uid
              && request.resource.data.keys().hasOnly(['uid', 'role', 'createdAt']) && request.resource.data.role == 'owner')
            || validInvite(family, uid)
          );
        function validInvite(family, uid) {
          let data = request.resource.data;
          let invitation = get(/databases/$(database)/documents/invites/$(data.inviteId)).data;
          return data.keys().hasOnly(['uid', 'role', 'createdAt', 'inviteId']) && data.role == 'member'
            && invitation.familyId == family && invitation.usedBy == null && invitation.expiresAt > request.time
            && getAfter(/databases/$(database)/documents/invites/$(data.inviteId)).data.usedBy == uid;
        }
      }

      match /records/{record} {
        function validRecord() {
          let r = request.resource.data;
          return r.keys().hasAll(['catId', 'type', 'grams', 'occurredAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'deletedAt'])
            && r.keys().hasOnly(['catId', 'type', 'grams', 'occurredAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'deletedAt'])
            && r.catId in ['MONET', 'RENOIR', 'UNASSIGNED'] && r.type in ['POOP', 'PEE', 'FOOD', 'VOMIT']
            && r.occurredAt is int && r.occurredAt >= 0 && r.occurredAt < 4102444800000
            && (r.type == 'FOOD' ? (r.grams is number && r.grams >= 0 && r.grams <= 10000) : r.grams == null)
            && r.createdBy is string && r.createdBy.size() > 0 && r.createdBy.size() <= 128
            && r.createdAt is timestamp && r.updatedBy == request.auth.uid && r.updatedAt == request.time
            && (r.deletedAt == null || r.deletedAt == request.time);
        }
        allow read: if member(family);
        allow create: if member(family) && record.matches('^[A-Za-z0-9_-]{1,128}$') && validRecord() && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if member(family) && validRecord() && resource.data.deletedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['catId', 'deletedAt', 'updatedAt', 'updatedBy']);
        allow delete: if false;
      }
    }

    match /invites/{token} {
      allow get: if verified(); // 256-bit bearer token. Collection listing is always forbidden.
      allow list: if false;
      allow create: if verified() && token.matches('^[A-Za-z0-9_-]{43}$')
        && owner(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'createdBy', 'createdAt', 'expiresAt', 'usedBy'])
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.usedBy == null && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if verified() && resource.data.usedBy == null && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.inviteId == token
        && getAfter(userPath()).data.familyId == resource.data.familyId;
      allow delete: if owner(resource.data.familyId);
    }
  }
}
